# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Local: local / Vercel: blob. Vercel uses two stores with different access modes.
STORAGE_MODE=local
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
POSTS_BLOB_STORE_ID=
POSTS_BLOB_READ_WRITE_TOKEN=

# Required on Vercel. Leave empty only for local development.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# OpenAI: empty = deterministic demo content
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_RESEARCH_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=25000
OPENAI_MAX_WEB_SEARCH_CALLS=8

# Cover photo: get a free API key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Instagram: true = do not publish, only build the API payload
INSTAGRAM_DRY_RUN=true
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
